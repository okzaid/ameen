{
  "hosting": {
    "public": "build/web",
    "predeploy": "flutter build web --release --web-renderer canvaskit --no-tree-shake-icons",
    "site": "ameen-zaidshaikh",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Ameen",
        "supportEmail": "zaidcae@gmail.com"
      }
    }
  }
}
